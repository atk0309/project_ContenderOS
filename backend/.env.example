# Backend (FastAPI) environment. Copy to .env and fill in. Secrets are server-side only.

ENVIRONMENT=development
# Comma-separated frontend origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
# Log output format: "json" (structured — Railway reads the real level from the payload) or
# "console" (readable plain lines). Leave empty to derive from ENVIRONMENT: console in development,
# json otherwise. Uvicorn applies this via --log-config log_config.json (see Dockerfile).
LOG_FORMAT=

# --- AI providers ---
# Provider API keys and model ids are NOT env vars: they're managed in the owner-only Admin Menu
# (keys encrypted in the DB, models picked per tier from the live provider list — ADR 0006).
# Legacy ANTHROPIC_API_KEY / OPENAI_API_KEY / *_MODEL_* entries in an old .env are ignored.

# Master key that encrypts the DB-stored provider keys (Fernet). The ONLY provider secret in env.
# Required outside development (the app fails closed without it). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- database ---
# Async driver required. On Railway use the managed-Postgres reference: DATABASE_URL=${{ Postgres.DATABASE_URL }}
# — the app normalizes a plain postgres://|postgresql:// scheme to postgresql+asyncpg:// at startup.
# Local dev needs no Postgres: point at SQLite instead (the default offline test suite already
# runs on it; only the Postgres-only concurrency tests need TEST_POSTGRES_URL), e.g.
#   DATABASE_URL=sqlite+aiosqlite:////tmp/contender-dev.db
# — see docs/runbooks/local-stack-and-ingest-verification.md.
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/contender

# --- auth: session + allowlist ---
# Strong random secret — signs the session cookie + magic-link tokens. `openssl rand -hex 32`.
AUTH_SECRET=
# Comma-separated allowlist: only these may sign in. EVERY entry is an owner (full edit) —
# removing an entry revokes that account's access on its next request (403).
ALLOWLIST_EMAILS=you@example.com
# Public frontend URL — the single public surface. All browser-facing redirects (magic-link
# callback, Entra redirect URI) point here; the frontend proxies /auth/*, /ai/*, /workspaces/*,
# and /admin/* (see frontend/src/lib/proxy.ts) to this backend
# over Railway's PRIVATE network, so the backend has no public domain. On Railway: the frontend URL.
FRONTEND_BASE_URL=http://localhost:3000
# Session cookie. Private-backend topology = browser is same-origin with the frontend, so SameSite
# can be "lax". COOKIE_SECURE=true on Railway (HTTPS); set false only for plain-http local dev.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# --- auth: magic-link login (Resend) ---
RESEND_API_KEY=
# Must be a Resend-verified domain to deliver to anyone (e.g. login@example.com).
RESEND_FROM=Contender <login@example.com>

# --- auth: M365 SSO (Microsoft Entra ID) — optional; routes return 503 until all three are set ---
# Register an app in Entra; set the redirect URI to: <FRONTEND_BASE_URL>/auth/entra/callback
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
