# Frontend (Next.js) environment. Copy to .env.local.

# PRIVATE backend URL the Next.js server proxies the backend API prefixes — /auth/*, /ai/*,
# /workspaces/*, /admin/* (see lib/proxy.ts) — to (server-to-server, never sent
# to the browser — NOT NEXT_PUBLIC). On Railway this is the internal host with no public domain,
# e.g. http://backend.railway.internal:8000. Locally, the dev backend. See lib/proxy.ts +
# docs/architecture/security.md. The browser is same-origin, so there is no public API base.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
