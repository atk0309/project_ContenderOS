{
  "name": "contender-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "node --no-experimental-webstorage ./node_modules/next/dist/bin/next dev",
    "build": "node --no-experimental-webstorage ./node_modules/next/dist/bin/next build",
    "start": "node --no-experimental-webstorage ./node_modules/next/dist/bin/next start",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "openapi-typescript ./openapi.json -o ./src/lib/api/generated-types.ts"
  },
  "dependencies": {
    "docx": "^9.8.0",
    "next": "^16.3.6",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^4.1.10"
  }
}
