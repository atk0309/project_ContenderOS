{
  "name": "contender-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "openapi-typescript ./openapi.json -o ./src/lib/api/generated-types.ts"
  },
  "dependencies": {
    "docx": "^9.1.0",
    "next": "^16.2.11",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "js-yaml@<4.2.0": ">=4.2.0",
      "esbuild@<0.28.1": ">=0.28.1"
    }
  }
}
