{
  "name": "contender-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "openapi-typescript ./openapi.json -o ./src/lib/api/generated-types.ts"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "next": "^16.2.11",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^4.1.10"
  }
}
